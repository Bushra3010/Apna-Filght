# Copy to .env.local and fill in. .env.local is git-ignored; never commit real keys.

# Supabase → Project Settings → API (or the "Connect" button → App frameworks)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Only for `npm run db:migrate` on your machine — never needed by the deployed app.
# Supabase → Connect → Session pooler → URI, with your database password filled in.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:5432/postgres
